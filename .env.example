# PayPal REST app credentials (SANDBOX ONLY, never live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal MCP server Handrail connects to. Options:
#   https://mcp.sandbox.paypal.com/sse   remote, SSE (the only path that works as of Oct 2026)
#   local                                spawn PayPal's @paypal/mcp package over stdio
# Run `npm run probe` to see which remote endpoints accept your token.
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/sse

# Admin API token (approve/reject held calls; later the dashboard). Generate one with:
#   openssl rand -hex 32
# Leave empty to disable the admin API.
HANDRAIL_ADMIN_TOKEN=

# Agent token for the HTTP /mcp endpoint (stdio agents don't need it). Leave
# empty to disable HTTP MCP. Generate with: openssl rand -hex 32
HANDRAIL_AGENT_TOKEN=

# PayPal webhook ID (developer dashboard > your app > Webhooks). Leave empty to
# disable the /webhooks/paypal endpoint.
PAYPAL_WEBHOOK_ID=
# Sandbox testing only: accept events that fail signature verification (the
# dashboard's webhook simulator sends those). Never enable in production.
# HANDRAIL_WEBHOOK_ALLOW_UNVERIFIED=true

# Anthropic API key (console.anthropic.com) for the AI features: plain-English
# explanations of held calls and compiling plain-English rules into policy.
# Leave empty to disable them; enforcement is deterministic and never uses AI.
ANTHROPIC_API_KEY=

# Optional
# HANDRAIL_AI_MODEL=claude-opus-5-5
# PORT=8787                            admin API (and /mcp when not in stdio mode)
# HANDRAIL_POLICY_PATH=policy.json
# HANDRAIL_APPROVAL_WAIT_SECONDS=20    how long a held call waits inline for a human
# HANDRAIL_APPROVAL_TTL_MINUTES=60     how long a held call stays approvable
# HANDRAIL_IDEMPOTENCY_WINDOW_MINUTES=60  identical calls (no idempotency_key) within this window are one operation
