# PayPal REST app credentials (SANDBOX ONLY, never live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal MCP server Handrail connects to. Options:
#   https://mcp.sandbox.paypal.com/sse   remote, SSE (the only path that works as of Oct 2026)
#   local                                spawn PayPal's @paypal/mcp package over stdio
# Run `npm run probe` to see which remote endpoints accept your token.
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/sse

# People sign in to the dashboard with their own accounts: the first sign-up
# becomes the admin, who invites everyone else. Agents reaching /mcp over HTTP
# use agent keys created in the dashboard (Admin > Agent keys).

# Optional, LOCAL ONLY: a bearer token for terminal scripts (npm run approvals,
# the demos). It acts as an admin on the API, recorded as "Admin script".
# Leave it empty and every bearer token is refused. NEVER set it on Render
# (Handrail refuses to start there with it). Generate with: openssl rand -hex 32
HANDRAIL_ADMIN_TOKEN=

# Optional: one extra agent key from .env, for agents set up before agent keys.
HANDRAIL_AGENT_TOKEN=

# "Try the demo" and "Run demo agent": an approver account anyone can sign in
# as, each sign-in in its own throwaway workspace (no access to real data). For
# the hackathon deployment only (sandbox). Off unless set to true.
# HANDRAIL_DEMO_ACCESS=true

# PayPal webhook ID (developer dashboard > your app > Webhooks). Leave empty to
# disable the /webhooks/paypal endpoint.
PAYPAL_WEBHOOK_ID=
# Sandbox testing only: accept events that fail signature verification (the
# dashboard's webhook simulator sends those). Never enable in production.
# HANDRAIL_WEBHOOK_ALLOW_UNVERIFIED=true

# Anthropic API key (console.anthropic.com) for the AI features: plain-English
# explanations of held calls and compiling plain-English rules into policy.
# Leave empty to disable them; enforcement is deterministic and never uses AI.
ANTHROPIC_API_KEY=

# Held-call alerts by email, via Brevo (brevo.com; free tier: 300 emails a day).
# Create an API key under SMTP & API, and verify the sender address under
# Senders. Set both, or neither: without them email alerts are off (the
# dashboard shows "Alerts off"). Slack is set by an admin in the dashboard.
BREVO_API_KEY=
HANDRAIL_ALERT_FROM=
# HANDRAIL_ALERT_FROM_NAME=Handrail
# Where the dashboard is reachable, for the link in alerts. On Render it
# defaults to RENDER_EXTERNAL_URL; locally to http://127.0.0.1:PORT.
# HANDRAIL_PUBLIC_URL=https://handrail.example.com

# Optional
# HANDRAIL_AI_MODEL=claude-opus-5-5
# PORT=8787                            admin API (and /mcp when not in stdio mode)
# HANDRAIL_POLICY_PATH=policy.json
# HANDRAIL_APPROVAL_WAIT_SECONDS=20    how long a held call waits inline for a human
# HANDRAIL_IDEMPOTENCY_WINDOW_MINUTES=60  identical calls (no idempotency_key) within this window are one operation
# HANDRAIL_TRUST_PROXY=true            behind a proxy such as Render: trust X-Forwarded-For/-Proto
# HANDRAIL_COOKIE_SECURE=auto          Secure session cookie; auto drops it only for http://localhost
