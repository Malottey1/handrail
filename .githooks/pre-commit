#!/bin/sh
# Blocks commits that contain secrets. Enabled by `npm install` (core.hooksPath).
node scripts/check-secrets.mjs || exit 1
# A second opinion, if gitleaks is installed (brew install gitleaks).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner . || exit 1
fi
