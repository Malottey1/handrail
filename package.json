{
  "name": "handrail",
  "version": "0.1.0",
  "description": "A safety layer between AI agents and PayPal's Agent Toolkit MCP server",
  "license": "MIT",
  "author": "Malcolm Clottey",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "dev:stdio": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts --stdio",
    "probe": "node --disable-warning=ExperimentalWarning --import tsx scripts/probe-upstream.ts",
    "smoke": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke-test.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "approvals": "node --disable-warning=ExperimentalWarning --import tsx scripts/approvals.ts",
    "demo:approval": "node --disable-warning=ExperimentalWarning --import tsx scripts/approval-demo.ts",
    "demo:retry-storm": "node --disable-warning=ExperimentalWarning --import tsx scripts/retry-storm.ts",
    "sandbox:capture": "node --disable-warning=ExperimentalWarning --import tsx scripts/sandbox-capture.ts",
    "check:drop-in": "node --disable-warning=ExperimentalWarning --import tsx scripts/drop-in-check.ts",
    "audit:verify": "node --disable-warning=ExperimentalWarning --import tsx scripts/audit-verify.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@node-rs/argon2": "^2.2.2",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "dotenv": "^18.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
